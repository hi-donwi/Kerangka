{
  "suite": "k1-expressions",
  "description": "K1 expression grammar, AST compilation, and evaluation rules",
  "cases": [
    {
      "id": "expr-add-mul-precedence",
      "description": "Multiplication binds tighter than addition",
      "input": { "expr": "2 + 3 * 4" },
      "expect": {
        "ast": {
          "$expr": "+",
          "args": [
            { "literal": 2 },
            { "$expr": "*", "args": [{ "literal": 3 }, { "literal": 4 }] }
          ]
        },
        "value": 14
      }
    },
    {
      "id": "expr-grouped-add-mul",
      "description": "Parentheses override operator precedence",
      "input": { "expr": "(2 + 3) * 4" },
      "expect": {
        "ast": {
          "$expr": "*",
          "args": [
            { "$expr": "+", "args": [{ "literal": 2 }, { "literal": 3 }] },
            { "literal": 4 }
          ]
        },
        "value": 20
      }
    },
    {
      "id": "expr-exact-decimal-add",
      "description": "0.1 + 0.2 must equal 0.3 without binary floating point artifacts",
      "input": { "expr": "0.1 + 0.2" },
      "expect": { "value": 0.3 }
    },
    {
      "id": "expr-null-arithmetic",
      "description": "Arithmetic with null propagates null",
      "input": { "expr": "100 + null" },
      "expect": { "value": null }
    },
    {
      "id": "expr-null-equality",
      "description": "null == null evaluates to true",
      "input": { "expr": "null == null" },
      "expect": { "value": true }
    },
    {
      "id": "expr-null-inequality",
      "description": "42 != null evaluates to true",
      "input": { "expr": "42 != null" },
      "expect": { "value": true }
    },
    {
      "id": "expr-null-relational",
      "description": "Comparisons against null evaluate to false",
      "input": { "expr": "50 > null" },
      "expect": { "value": false }
    },
    {
      "id": "expr-logical-and-or",
      "description": "Logical AND and OR short circuit evaluation",
      "input": { "expr": "true || false" },
      "expect": { "value": true }
    },
    {
      "id": "expr-unary-negation",
      "description": "Unary minus negates numbers",
      "input": { "expr": "-15 + 20" },
      "expect": { "value": 5 }
    },
    {
      "id": "expr-unary-not",
      "description": "Unary exclamation inverts boolean",
      "input": { "expr": "!false" },
      "expect": { "value": true }
    },
    {
      "id": "expr-path-binding",
      "description": "Paths resolve against context",
      "input": {
        "expr": "user.address.city",
        "context": { "user": { "address": { "city": "Jakarta" } } }
      },
      "expect": {
        "ast": { "$bind": "user.address.city" },
        "value": "Jakarta"
      }
    },
    {
      "id": "expr-builtin-math-abs",
      "description": "abs() returns absolute value",
      "input": { "expr": "abs(-99)" },
      "expect": { "value": 99 }
    },
    {
      "id": "expr-builtin-math-round",
      "description": "round() rounds to specified decimals",
      "input": { "expr": "round(123.456, 2)" },
      "expect": { "value": 123.46 }
    },
    {
      "id": "expr-builtin-string-upper",
      "description": "upper() converts string to uppercase",
      "input": { "expr": "upper('kerangka')" },
      "expect": { "value": "KERANGKA" }
    },
    {
      "id": "expr-builtin-collection-sum",
      "description": "sum() aggregates a collection field",
      "input": {
        "expr": "sum(items, 'price')",
        "context": {
          "items": [{ "price": 10.5 }, { "price": 20.25 }, { "price": 4.25 }]
        }
      },
      "expect": { "value": 35 }
    },
    {
      "id": "expr-builtin-collection-count",
      "description": "count() returns list item count",
      "input": {
        "expr": "count(items)",
        "context": { "items": ["a", "b", "c", "d"] }
      },
      "expect": { "value": 4 }
    },
    {
      "id": "expr-coalesce",
      "description": "coalesce() returns first non-null argument",
      "input": { "expr": "coalesce(null, null, 'fallback')" },
      "expect": { "value": "fallback" }
    },
    {
      "id": "expr-sub-basic",
      "description": "Subtraction subtracts right operand from left",
      "input": { "expr": "20 - 7" },
      "expect": { "value": 13 }
    },
    {
      "id": "expr-mul-basic",
      "description": "Multiplication multiplies numbers",
      "input": { "expr": "6 * 7" },
      "expect": { "value": 42 }
    },
    {
      "id": "expr-div-basic",
      "description": "Division divides numbers",
      "input": { "expr": "100 / 4" },
      "expect": { "value": 25 }
    },
    {
      "id": "expr-div-decimal",
      "description": "Division produces decimal quotients",
      "input": { "expr": "10 / 4" },
      "expect": { "value": 2.5 }
    },
    {
      "id": "expr-mod-basic",
      "description": "Modulo returns integer remainder",
      "input": { "expr": "17 % 5" },
      "expect": { "value": 2 }
    },
    {
      "id": "expr-complex-precedence",
      "description": "Complex arithmetic respects standard precedence",
      "input": { "expr": "10 + 2 * 3 - 4 / 2" },
      "expect": { "value": 14 }
    },
    {
      "id": "expr-paren-nested",
      "description": "Nested parentheses evaluate innermost first",
      "input": { "expr": "((2 + 3) * (4 - 1)) / 3" },
      "expect": { "value": 5 }
    },
    {
      "id": "expr-decimal-sub",
      "description": "Exact decimal subtraction without precision leak",
      "input": { "expr": "0.3 - 0.1" },
      "expect": { "value": 0.2 }
    },
    {
      "id": "expr-decimal-mul",
      "description": "Exact decimal multiplication",
      "input": { "expr": "0.2 * 0.3" },
      "expect": { "value": 0.06 }
    },
    {
      "id": "expr-decimal-div",
      "description": "Exact decimal division",
      "input": { "expr": "0.3 / 0.1" },
      "expect": { "value": 3 }
    },
    {
      "id": "expr-eq-numbers",
      "description": "Equality on identical numbers is true",
      "input": { "expr": "42 == 42" },
      "expect": { "value": true }
    },
    {
      "id": "expr-eq-numbers-false",
      "description": "Equality on different numbers is false",
      "input": { "expr": "42 == 43" },
      "expect": { "value": false }
    },
    {
      "id": "expr-neq-strings",
      "description": "Inequality on different strings is true",
      "input": { "expr": "'apple' != 'banana'" },
      "expect": { "value": true }
    },
    {
      "id": "expr-neq-strings-false",
      "description": "Inequality on identical strings is false",
      "input": { "expr": "'apple' != 'apple'" },
      "expect": { "value": false }
    },
    {
      "id": "expr-lt-true",
      "description": "Less than returns true when left is smaller",
      "input": { "expr": "15 < 20" },
      "expect": { "value": true }
    },
    {
      "id": "expr-lt-false",
      "description": "Less than returns false when left is greater",
      "input": { "expr": "20 < 15" },
      "expect": { "value": false }
    },
    {
      "id": "expr-lte-equal",
      "description": "Less than or equal returns true when operands are equal",
      "input": { "expr": "20 <= 20" },
      "expect": { "value": true }
    },
    {
      "id": "expr-lte-less",
      "description": "Less than or equal returns true when left is smaller",
      "input": { "expr": "19 <= 20" },
      "expect": { "value": true }
    },
    {
      "id": "expr-gt-true",
      "description": "Greater than returns true when left is greater",
      "input": { "expr": "100 > 99" },
      "expect": { "value": true }
    },
    {
      "id": "expr-gte-equal",
      "description": "Greater than or equal returns true when operands are equal",
      "input": { "expr": "50 >= 50" },
      "expect": { "value": true }
    },
    {
      "id": "expr-eq-strings",
      "description": "Equality on matching strings is true",
      "input": { "expr": "'status' == 'status'" },
      "expect": { "value": true }
    },
    {
      "id": "expr-neq-numbers",
      "description": "Inequality on distinct numbers is true",
      "input": { "expr": "10 != 20" },
      "expect": { "value": true }
    },
    {
      "id": "expr-logical-and-true",
      "description": "Logical AND returns true when both operands are true",
      "input": { "expr": "true && true" },
      "expect": { "value": true }
    },
    {
      "id": "expr-logical-and-false",
      "description": "Logical AND returns false when right operand is false",
      "input": { "expr": "true && false" },
      "expect": { "value": false }
    },
    {
      "id": "expr-logical-or-false",
      "description": "Logical OR returns false when both operands are false",
      "input": { "expr": "false || false" },
      "expect": { "value": false }
    },
    {
      "id": "expr-logical-and-chain",
      "description": "Chained AND operators evaluate to true",
      "input": { "expr": "true && true && true" },
      "expect": { "value": true }
    },
    {
      "id": "expr-logical-or-chain",
      "description": "Chained OR operators evaluate to true",
      "input": { "expr": "false || false || true" },
      "expect": { "value": true }
    },
    {
      "id": "expr-double-negation",
      "description": "Double boolean negation restores original boolean",
      "input": { "expr": "!!true" },
      "expect": { "value": true }
    },
    {
      "id": "expr-math-ceil",
      "description": "ceil() rounds up to next integer",
      "input": { "expr": "ceil(4.2)" },
      "expect": { "value": 5 }
    },
    {
      "id": "expr-math-floor",
      "description": "floor() rounds down to previous integer",
      "input": { "expr": "floor(4.9)" },
      "expect": { "value": 4 }
    },
    {
      "id": "expr-math-min",
      "description": "min() returns smallest of two numbers",
      "input": { "expr": "min(10, 20)" },
      "expect": { "value": 10 }
    },
    {
      "id": "expr-math-max",
      "description": "max() returns largest of two numbers",
      "input": { "expr": "max(10, 20)" },
      "expect": { "value": 20 }
    },
    {
      "id": "expr-math-round-default",
      "description": "round() without decimals parameter rounds to nearest integer",
      "input": { "expr": "round(4.6)" },
      "expect": { "value": 5 }
    },
    {
      "id": "expr-math-round-three",
      "description": "round() to three decimal places",
      "input": { "expr": "round(1.23456, 3)" },
      "expect": { "value": 1.235 }
    },
    {
      "id": "expr-string-lower",
      "description": "lower() converts string to lowercase",
      "input": { "expr": "lower('HELLO WORLD')" },
      "expect": { "value": "hello world" }
    },
    {
      "id": "expr-string-trim",
      "description": "trim() removes leading and trailing whitespace",
      "input": { "expr": "trim('  spaced  ')" },
      "expect": { "value": "spaced" }
    },
    {
      "id": "expr-string-len",
      "description": "len() returns string length",
      "input": { "expr": "len('kerangka')" },
      "expect": { "value": 8 }
    },
    {
      "id": "expr-string-contains-true",
      "description": "contains() returns true when substring is found",
      "input": { "expr": "contains('hello world', 'world')" },
      "expect": { "value": true }
    },
    {
      "id": "expr-string-contains-false",
      "description": "contains() returns false when substring is missing",
      "input": { "expr": "contains('hello world', 'universe')" },
      "expect": { "value": false }
    },
    {
      "id": "expr-string-concat",
      "description": "concat() joins multiple string arguments",
      "input": { "expr": "concat('Foo', 'Bar', 'Baz')" },
      "expect": { "value": "FooBarBaz" }
    },
    {
      "id": "expr-string-add-concat",
      "description": "+ operator concatenates when both operands are strings",
      "input": { "expr": "'Hello ' + 'World'" },
      "expect": { "value": "Hello World" }
    },
    {
      "id": "expr-collection-avg",
      "description": "avg() calculates arithmetic mean of collection field",
      "input": {
        "expr": "avg(items, 'val')",
        "context": { "items": [{ "val": 3 }, { "val": 6 }, { "val": 9 }] }
      },
      "expect": { "value": 6 }
    },
    {
      "id": "expr-collection-contains",
      "description": "contains() checks item membership in array",
      "input": {
        "expr": "contains(items, 'b')",
        "context": { "items": ["a", "b", "c"] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-collection-len",
      "description": "len() returns array length",
      "input": {
        "expr": "len(items)",
        "context": { "items": [1, 2, 3] }
      },
      "expect": { "value": 3 }
    },
    {
      "id": "expr-collection-count-empty",
      "description": "count() on empty list returns 0",
      "input": {
        "expr": "count(items)",
        "context": { "items": [] }
      },
      "expect": { "value": 0 }
    },
    {
      "id": "expr-collection-sum-expr",
      "description": "sum() aggregates evaluated per-row expression",
      "input": {
        "expr": "sum(lines, qty * price)",
        "context": {
          "lines": [
            { "qty": 2, "price": 10 },
            { "qty": 3, "price": 5 }
          ]
        }
      },
      "expect": { "value": 35 }
    },
    {
      "id": "expr-isSet-true",
      "description": "isSet() returns true for non-null value",
      "input": {
        "expr": "isSet(val)",
        "context": { "val": "active" }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-isSet-false",
      "description": "isSet() returns false for null value",
      "input": {
        "expr": "isSet(val)",
        "context": { "val": null }
      },
      "expect": { "value": false }
    },
    {
      "id": "expr-uidl-add",
      "description": "UIDL canonical $expr 'add' evaluates decimal addition",
      "input": {
        "ast": { "$expr": "add", "args": [{ "literal": 10.5 }, { "literal": 20.25 }] }
      },
      "expect": { "value": 30.75 }
    },
    {
      "id": "expr-uidl-subtract",
      "description": "UIDL canonical $expr 'subtract' evaluates subtraction",
      "input": {
        "ast": { "$expr": "subtract", "args": [{ "literal": 50 }, { "literal": 18.5 }] }
      },
      "expect": { "value": 31.5 }
    },
    {
      "id": "expr-uidl-multiply",
      "description": "UIDL canonical $expr 'multiply' evaluates multiplication",
      "input": {
        "ast": { "$expr": "multiply", "args": [{ "literal": 6 }, { "literal": 7 }] }
      },
      "expect": { "value": 42 }
    },
    {
      "id": "expr-uidl-divide",
      "description": "UIDL canonical $expr 'divide' evaluates division",
      "input": {
        "ast": { "$expr": "divide", "args": [{ "literal": 100 }, { "literal": 4 }] }
      },
      "expect": { "value": 25 }
    },
    {
      "id": "expr-uidl-eq",
      "description": "UIDL canonical $expr 'eq' evaluates equality",
      "input": {
        "ast": { "$expr": "eq", "args": [{ "$bind": "status" }, { "literal": "active" }] },
        "context": { "status": "active" }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-neq",
      "description": "UIDL canonical $expr 'neq' evaluates inequality",
      "input": {
        "ast": { "$expr": "neq", "args": [{ "literal": "draft" }, { "literal": "published" }] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-gt",
      "description": "UIDL canonical $expr 'gt' evaluates strictly greater than",
      "input": {
        "ast": { "$expr": "gt", "args": [{ "literal": 20 }, { "literal": 10 }] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-gte",
      "description": "UIDL canonical $expr 'gte' evaluates greater than or equal",
      "input": {
        "ast": { "$expr": "gte", "args": [{ "literal": 10 }, { "literal": 10 }] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-lt",
      "description": "UIDL canonical $expr 'lt' evaluates strictly less than",
      "input": {
        "ast": { "$expr": "lt", "args": [{ "literal": 5 }, { "literal": 10 }] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-lte",
      "description": "UIDL canonical $expr 'lte' evaluates less than or equal",
      "input": {
        "ast": { "$expr": "lte", "args": [{ "literal": 5 }, { "literal": 5 }] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-and",
      "description": "UIDL canonical $expr 'and' evaluates logical conjunction",
      "input": {
        "ast": { "$expr": "and", "args": [{ "literal": true }, { "literal": false }] }
      },
      "expect": { "value": false }
    },
    {
      "id": "expr-uidl-or",
      "description": "UIDL canonical $expr 'or' evaluates logical disjunction",
      "input": {
        "ast": { "$expr": "or", "args": [{ "literal": false }, { "literal": true }] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-not",
      "description": "UIDL canonical $expr 'not' evaluates logical negation",
      "input": {
        "ast": { "$expr": "not", "args": [{ "literal": false }] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-if-true",
      "description": "UIDL canonical $expr 'if' returns then branch when condition holds",
      "input": {
        "ast": {
          "$expr": "if",
          "args": [{ "literal": true }, { "literal": "approved" }, { "literal": "pending" }]
        }
      },
      "expect": { "value": "approved" }
    },
    {
      "id": "expr-uidl-if-false",
      "description": "UIDL canonical $expr 'if' returns else branch when condition is false",
      "input": {
        "ast": {
          "$expr": "if",
          "args": [{ "literal": false }, { "literal": "approved" }, { "literal": "pending" }]
        }
      },
      "expect": { "value": "pending" }
    },
    {
      "id": "expr-uidl-coalesce",
      "description": "UIDL canonical $expr 'coalesce' returns first non-null operand",
      "input": {
        "ast": {
          "$expr": "coalesce",
          "args": [{ "$bind": "missing" }, { "literal": null }, { "literal": "fallback" }]
        },
        "context": {}
      },
      "expect": { "value": "fallback" }
    },
    {
      "id": "expr-uidl-contains-str",
      "description": "UIDL canonical $expr 'contains' checks substring membership",
      "input": {
        "ast": {
          "$expr": "contains",
          "args": [{ "literal": "Kerangka Specification" }, { "literal": "Specification" }]
        }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-contains-arr",
      "description": "UIDL canonical $expr 'contains' checks array membership",
      "input": {
        "ast": {
          "$expr": "contains",
          "args": [{ "$bind": "roles" }, { "literal": "admin" }]
        },
        "context": { "roles": ["user", "manager", "admin"] }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-startsWith",
      "description": "UIDL canonical $expr 'startsWith' checks prefix matching",
      "input": {
        "ast": {
          "$expr": "startsWith",
          "args": [{ "literal": "INV-2026-001" }, { "literal": "INV-" }]
        }
      },
      "expect": { "value": true }
    },
    {
      "id": "expr-uidl-in",
      "description": "UIDL canonical $expr 'in' checks item in collection",
      "input": {
        "ast": {
          "$expr": "in",
          "args": [{ "literal": "paid" }, { "$bind": "closedStatuses" }]
        },
        "context": { "closedStatuses": ["paid", "void", "refunded"] }
      },
      "expect": { "value": true }
    }
  ]
}
