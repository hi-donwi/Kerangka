    {
      "id": "workflow-guard-with-actor-pass",
      "description": "Transition guard succeeds when evaluating actor property against record",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Task": {
              "fields": {
                "status": "string!",
                "assignee": "string!"
              },
              "workflow": {
                "field": "status",
                "transitions": {
                  "claim": {
                    "from": "assigned",
                    "to": "in_progress",
                    "when": "actor.id == record.assignee"
                  }
                }
              }
            }
          }
        },
        "record": { "status": "assigned", "assignee": "user_42" },
        "transition": "claim",
        "actor": { "id": "user_42", "roles": ["engineer"] }
      },
      "expect": {
        "ok": true,
        "record": { "status": "in_progress", "assignee": "user_42" }
      }
    },
    {
      "id": "workflow-guard-with-actor-fail",
