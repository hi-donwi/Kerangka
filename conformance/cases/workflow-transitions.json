    {
      "id": "workflow-then-set-mutation",
      "description": "Transition then-effects mutate record fields as specified in set",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "SecurityPolicy": {
              "fields": {
                "status": "string!",
                "locked": "bool!",
                "attempts": "int!"
              },
              "workflow": {
                "field": "status",
                "transitions": {
                  "lock": {
                    "from": "active",
                    "to": "suspended",
                    "then": [
                      { "set": { "locked": true, "attempts": 0 } }
                    ]
                  }
                }
              }
            }
          }
        },
        "record": { "status": "active", "locked": false, "attempts": 5 },
        "transition": "lock"
      },
      "expect": {
        "ok": true,
        "record": { "status": "suspended", "locked": true, "attempts": 0 }
      }
    },
    {
      "id": "workflow-with-computed-field",
      "description": "Transition re-evaluates computed fields on the record after state change",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Document": {
              "fields": {
                "status": "string!",
                "isDraft": { "type": "bool", "compute": "status == 'draft'" }
              },
              "workflow": {
                "field": "status",
                "transitions": {
                  "submit": {
                    "from": "draft",
                    "to": "submitted"
                  }
                }
              }
            }
          }
        },
        "record": { "status": "draft" },
        "transition": "submit"
      },
      "expect": {
        "ok": true,
        "record": { "status": "submitted", "isDraft": false }
      }
    },
    {
      "id": "workflow-declared-states-pass",
      "description": "Transition succeeds in workflow with explicitly declared states",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Ticket": {
              "fields": { "status": "string!" },
              "workflow": {
                "field": "status",
                "states": ["draft", "submitted", "approved"],
                "transitions": {
                  "submit": {
                    "from": "draft",
                    "to": "submitted"
                  }
                }
              }
            }
          }
        },
        "record": { "status": "draft" },
        "transition": "submit"
      },
      "expect": {
        "ok": true,
        "record": { "status": "submitted" }
      }
    },
    {
      "id": "workflow-guard-or-pass",
      "description": "Transition guard succeeds when one condition in OR expression is true",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Member": {
              "fields": {
                "status": "string!",
                "isVip": "bool!",
                "credits": "int!"
              },
              "workflow": {
                "field": "status",
                "transitions": {
                  "admit": {
                    "from": "waiting",
                    "to": "admitted",
                    "when": "isVip == true || credits > 0"
                  }
                }
              }
            }
          }
        },
        "record": { "status": "waiting", "isVip": false, "credits": 5 },
        "transition": "admit"
      },
      "expect": {
        "ok": true,
        "record": { "status": "admitted", "isVip": false, "credits": 5 }
      }
    },
    {
      "id": "workflow-guard-or-fail",
      "description": "Transition guard fails when both conditions in OR expression are false",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Member": {
              "fields": {
                "status": "string!",
                "isVip": "bool!",
                "credits": "int!"
              },
              "workflow": {
                "field": "status",
                "transitions": {
                  "admit": {
                    "from": "waiting",
                    "to": "admitted",
                    "when": "isVip == true || credits > 0"
                  }
                }
              }
            }
          }
        },
        "record": { "status": "waiting", "isVip": false, "credits": 0 },
        "transition": "admit"
      },
      "expect": {
        "ok": false,
        "error": "GUARD_FAILED"
      }
    }
  ]
}
