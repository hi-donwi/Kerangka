    {
      "id": "workflow-guard-null-check-pass",
      "description": "Transition guard succeeds when field is not null",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Submission": {
              "fields": {
                "status": "string!",
