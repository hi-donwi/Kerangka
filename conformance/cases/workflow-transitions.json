    {
      "id": "workflow-guard-compound-and-pass",
      "description": "Transition guard succeeds when compound AND expression is satisfied",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Account": {
              "fields": {
                "status": "string!",
                "verified": "bool!",
                "balance": "int!"
              },
              "workflow": {
                "field": "status",
                "transitions": {
                  "activate": {
                    "from": "pending",
                    "to": "active",
                    "when": "verified == true && balance >= 100"
                  }
                }
              }
            }
          }
        },
        "record": { "status": "pending", "verified": true, "balance": 250 },
        "transition": "activate"
      },
      "expect": {
        "ok": true,
        "record": { "status": "active", "verified": true, "balance": 250 }
      }
    },
