    {
      "id": "workflow-guard-string-comparison",
      "description": "Transition guard succeeds with string literal comparison",
      "input": {
        "model": {
          "kerangka": "0.1",
          "app": "wf-test",
          "entities": {
            "Order": {
              "fields": {
                "status": "string!",
