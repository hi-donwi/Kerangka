{
  "name": "kerangka-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:conformance": "vitest run conformance",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "npm run --workspaces --if-present clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
