{
  "name": "kerangka-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:conformance": "vitest run conformance",
    "test:watch": "vitest",
    "test:studio:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config apps/studio/playwright.config.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w @kerangka/studio",
    "examples:verify": "node scripts/verify-examples.mjs",
    "verify": "npm run typecheck && npm run test && npm run examples:verify",
    "clean": "npm run --workspaces --if-present clean"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.13.10",
    "ajv": "8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "license": "Apache-2.0"
}
