{
  "name": "kerangka-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:conformance": "vitest run conformance",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "examples:verify": "node scripts/verify-examples.mjs",
    "verify": "npm run typecheck && npm run test && npm run examples:verify",
    "clean": "npm run --workspaces --if-present clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
