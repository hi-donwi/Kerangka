{
  "name": "kerangka",
  "version": "0.1.0",
  "description": "Kerangka CLI compiler, checker, and inspection tool",
  "type": "module",
  "bin": {
    "kerangka": "./dist/bin/kerangka.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin/kerangka.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kerangka/k1": "*",
    "@kerangka/compiler": "*",
    "@kerangka/engine-ts": "*"
  },
  "license": "Apache-2.0"
}
