{
  "name": "@kerangka/compiler",
  "version": "0.1.0",
  "description": "Compiler pipeline transforming Kerangka models to canonical intermediate representation (KIR)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model.schema.json": "./schemas/kerangka.model.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kerangka/k1": "*",
    "@kerangka/std": "*",
    "yaml": "^2.7.0"
  },
  "license": "Apache-2.0",
  "files": [
    "schemas"
  ]
}
