{
  "name": "@kerangka/uidl-projector",
  "version": "0.1.1",
  "description": "Compiles a Kerangka model's views into UIDL screens per request, through uidl-runtime's page recipes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kerangka/compiler": "*",
    "uidl-runtime": "^0.1.12"
  },
  "license": "Apache-2.0"
}
