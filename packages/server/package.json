{
  "name": "@kerangka/server",
  "version": "0.1.0",
  "description": "Zero-config development and API server for Kerangka models",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kerangka/adapter-hono": "*",
    "@kerangka/adapter-sqlite": "*",
    "@kerangka/compiler": "*",
    "@kerangka/engine-ts": "*",
    "@kerangka/ports": "*",
    "@kerangka/uidl-projector": "*"
  },
  "license": "Apache-2.0"
}
