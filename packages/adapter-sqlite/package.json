{
  "name": "@kerangka/adapter-sqlite",
  "version": "0.1.0",
  "description": "Zero-dependency SQLite store adapter for Kerangka using Node 22 native SQLite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kerangka/ports": "*",
    "@kerangka/compiler": "*"
  },
  "license": "Apache-2.0"
}
