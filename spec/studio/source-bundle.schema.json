{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kerangka.dev/schema/studio/v0.1/source-bundle.schema.json",
  "title": "Kerangka Studio source bundle 0.1",
  "description": "Authoring data only. Structural validation does not authorize filesystem access, preview effects, compilation, or release. See docs/studio/source-bundle.md for semantic gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "revision", "entry", "sources", "application"],
  "properties": {
    "$schema": { "const": "https://kerangka.dev/schema/studio/v0.1/source-bundle.schema.json" },
    "kind": { "const": "kerangka.studio.source" },
    "version": { "const": "0.1" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "entry": { "type": "string", "$ref": "#/$defs/sourcePath", "pattern": "\\.(json|yaml|yml)$" },
    "sources": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/sourcePath" },
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["pages", "routes", "preview"],
      "properties": {
        "pages": {
          "type": "object", "maxProperties": 100,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/recipePage" }, { "$ref": "#/$defs/authoredPage" }] }
        },
        "routes": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/route" } },
        "preview": {
          "type": "object", "additionalProperties": false,
          "required": ["profile", "data"],
          "properties": { "profile": { "const": "read" }, "data": { "const": "synthetic" } }
        }
      }
    },
    "editor": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "positions": {
          "type": "object", "maxProperties": 2000,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 256 },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
              "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$",
      "not": { "enum": ["constructor", "prototype"] }
    },
    "sourcePath": {
      "type": "string", "maxLength": 240,
      "pattern": "^(?:(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(?:json|yaml|yml)|kerangka\\.lock)$",
      "not": { "pattern": "(?:^|/)(?:node_modules|dist|build|vendor)(?:/|$)" }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["format", "text"],
      "properties": {
        "format": { "enum": ["json", "yaml"] },
        "text": { "type": "string", "maxLength": 524288 }
      }
    },
    "recipePage": {
      "type": "object", "additionalProperties": false, "required": ["mode", "view"],
      "properties": { "mode": { "const": "recipe" }, "view": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "authoredPage": {
      "type": "object", "additionalProperties": false, "required": ["mode", "source"],
      "properties": {
        "mode": { "const": "authored" },
        "source": { "type": "string", "$ref": "#/$defs/sourcePath", "pattern": "\\.uidl\\.json$" }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "page", "access"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": {
          "type": "string", "maxLength": 240,
          "pattern": "^(?:/|/(?:[A-Za-z0-9_-]+|:[A-Za-z][A-Za-z0-9_]*)(?:/(?:[A-Za-z0-9_-]+|:[A-Za-z][A-Za-z0-9_]*))*)$"
        },
        "page": { "$ref": "#/$defs/id" },
        "access": { "enum": ["public", "session"] }
      }
    }
  }
}
