[
  {
    "id": "approval",
    "title": "Expense Approval",
    "modelPath": "samples/approval/expense-approval.kerangka.json",
    "docsPath": "/Kerangka/docs/v0.1.1/reference/samples/",
    "sourcePath": "examples/expense-approval.kerangka.json",
    "allowedModes": [
      "preview",
      "run"
    ],
    "inputs": [
      {
        "name": "submit-draft",
        "run": "Expense.submit",
        "record": {
          "description": "Train ticket",
          "amount": "42.00",
          "status": "draft"
        },
        "actor": {
          "roles": [
            "employee"
          ]
        }
      },
      {
        "name": "approve-as-manager",
        "run": "Expense.approve",
        "record": {
          "description": "Train ticket",
          "amount": "42.00",
          "status": "submitted"
        },
        "actor": {
          "roles": [
            "manager"
          ]
        }
      },
      {
        "name": "approve-as-employee",
        "run": "Expense.approve",
        "record": {
          "description": "Train ticket",
          "amount": "42.00",
          "status": "submitted"
        },
        "actor": {
          "roles": [
            "employee"
          ]
        }
      }
    ],
    "expected": {
      "outcomes": [
        {
          "input": "submit-draft",
          "status": "ok",
          "record": {
            "status": "submitted"
          }
        },
        {
          "input": "approve-as-manager",
          "status": "ok",
          "record": {
            "status": "approved"
          }
        },
        {
          "input": "approve-as-employee",
          "status": "denied",
          "error": "PERMISSION_DENIED"
        }
      ]
    },
    "support": "supported",
    "version": "v0.1.1"
  },
