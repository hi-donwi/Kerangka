[
  {
    "id": "approval",
    "title": "Expense Approval",
    "modelPath": "samples/approval/expense-approval.kerangka.json",
    "docsPath": "/Kerangka/docs/v0.1.1/reference/samples/",
    "sourcePath": "examples/expense-approval.kerangka.json",
    "allowedModes": [
      "preview",
      "run"
    ],
    "inputs": [
      {
        "name": "submit-draft",
        "description": "An employee submits a draft expense; the state moves to submitted.",
        "run": "Expense.submit",
        "record": {
          "description": "Train ticket",
          "amount": "42.00",
          "status": "draft"
        },
        "actor": {
          "roles": [
            "employee"
          ]
        }
      },
      {
        "name": "approve-as-manager",
        "description": "A manager approves a submitted expense and advances its state.",
        "run": "Expense.approve",
        "record": {
          "description": "Train ticket",
          "amount": "42.00",
          "status": "submitted"
        },
        "actor": {
          "roles": [
            "manager"
          ]
        }
      },
      {
        "name": "approve-as-employee",
        "description": "An employee attempts manager-only approval and is denied by the role guard.",
        "run": "Expense.approve",
        "record": {
          "description": "Train ticket",
          "amount": "42.00",
          "status": "submitted"
        },
        "actor": {
          "roles": [
            "employee"
          ]
        }
      }
    ],
    "expected": {
      "outcomes": [
        {
          "input": "submit-draft",
          "status": "ok",
          "record": {
            "status": "submitted"
          }
        },
        {
          "input": "approve-as-manager",
          "status": "ok",
          "record": {
            "status": "approved"
          }
        },
        {
          "input": "approve-as-employee",
          "status": "denied",
          "error": "PERMISSION_DENIED"
        }
      ]
    },
    "support": "supported",
    "version": "v0.1.1"
  },
  {
    "id": "validation",
    "title": "Field, Expression, and Validation",
    "modelPath": "samples/validation/invoicing.kerangka.json",
    "docsPath": "/Kerangka/docs/v0.1.1/concepts/validation/",
    "sourcePath": "examples/invoicing.kerangka.json",
    "allowedModes": [
      "preview",
      "run"
    ],
    "inputs": [
      {
        "name": "empty-invoice",
        "description": "An empty draft is denied because sending requires at least one line with a positive total.",
        "run": "Invoice.send",
        "record": {
          "status": "draft",
          "lines": []
        },
        "actor": {
          "roles": [
            "billing"
          ]
        }
      },
      {
        "name": "send-standard-invoice",
        "description": "A billing user sends a $42 invoice; the ordinary-value audit branch is recorded.",
        "run": "Invoice.send",
        "record": {
          "number": "INV-2026-001",
          "customer": "customer-1",
          "issuedOn": "2026-10-01",
          "dueDate": "2026-10-31",
          "lines": [
            { "description": "Consulting", "qty": 1, "unitPrice": "42.00" }
          ],
          "status": "draft"
        },
        "actor": {
          "roles": [
            "billing"
          ]
        }
      },
      {
        "name": "send-high-value-invoice",
        "description": "A billing user sends a $1,500 invoice; the high-value audit branch is recorded.",
        "run": "Invoice.send",
        "record": {
          "number": "INV-2026-002",
          "customer": "customer-1",
          "issuedOn": "2026-10-01",
          "dueDate": "2026-10-31",
          "lines": [
            { "description": "Annual service", "qty": 1, "unitPrice": "1500.00" }
          ],
          "status": "draft"
        },
        "actor": {
          "roles": [
            "billing"
          ]
        }
      }
    ],
    "expected": {
      "outcomes": [
        {
          "input": "empty-invoice",
          "status": "denied",
          "error": "GUARD_FAILED"
        },
        {
          "input": "send-standard-invoice",
          "status": "ok",
          "record": {
            "status": "sent",
            "auditTrail": ["sent-INV-2026-001"]
          }
        },
        {
          "input": "send-high-value-invoice",
          "status": "ok",
          "record": {
            "status": "sent",
            "auditTrail": ["high-value-INV-2026-002"]
          }
        }
      ]
    },
    "support": "supported",
    "version": "v0.1.1"
  },
  {
    "id": "workflow",
    "title": "Action, Workflow, and Decision",
    "modelPath": "samples/workflow/leave-request.kerangka.json",
    "docsPath": "/Kerangka/docs/v0.1.1/concepts/workflow/",
    "sourcePath": "examples/leave-request.kerangka.json",
    "allowedModes": [
      "preview",
      "run"
    ],
    "inputs": [
      {
        "name": "submit-2-days",
        "description": "Two days of leave route to a team lead (the first routing threshold).",
        "run": "LeaveRequest.submit",
        "record": {
          "employeeId": "emp-1",
          "days": 2,
          "status": "draft",
          "startDate": "2026-10-01",
          "endDate": "2026-10-02"
        },
        "actor": {
          "roles": [
            "employee"
          ]
        }
      },
      {
        "name": "submit-6-days",
        "description": "Six days exceed the five-day threshold and route to the HR director.",
        "run": "LeaveRequest.submit",
        "record": {
          "employeeId": "emp-1",
          "days": 6,
          "status": "draft",
          "startDate": "2026-10-01",
          "endDate": "2026-10-07"
        },
        "actor": {
          "roles": [
            "employee"
          ]
        }
      },
      {
        "name": "submit-5-days",
        "description": "Exactly five days exercise the upper boundary and route to a department manager.",
        "run": "LeaveRequest.submit",
        "record": {
          "employeeId": "emp-1",
          "days": 5,
          "status": "draft",
          "startDate": "2026-10-01",
          "endDate": "2026-10-06"
        },
        "actor": {
          "roles": [
            "employee"
          ]
        }
      }
    ],
    "expected": {
      "outcomes": [
        {
          "input": "submit-2-days",
          "status": "ok",
          "record": {
            "status": "submitted",
            "assignedApproverRole": "team-lead"
          }
        },
        {
          "input": "submit-6-days",
          "status": "ok",
          "record": {
            "status": "submitted",
            "assignedApproverRole": "hr-director"
          }
        },
        {
          "input": "submit-5-days",
          "status": "ok",
          "record": {
            "status": "submitted",
            "assignedApproverRole": "department-manager"
          }
        }
      ]
    },
    "support": "supported",
    "version": "v0.1.1"
  }
]
