{
  "context": "inventory",
  "glossary": {
    "StockReservation": "Temporary hold placed on warehouse stock for a pending order"
  },
  "dependsOn": [
    "orders"
  ],
  "entities": {
    "StockReservation": {
      "fields": {
        "orderId": "uuid!",
        "status": "enum(active, fulfilled, cancelled) = active",
        "reservedAt": "datetime"
      },
      "workflow": {
        "field": "status",
        "transitions": {
          "fulfill": {
            "from": "active",
            "to": "fulfilled"
          },
          "cancel": {
            "from": "active",
            "to": "cancelled"
          }
        }
      },
      "actions": {
        "create": {
          "roles": [
            "system"
          ]
        }
      }
    }
  },
  "policies": {
    "onOrderPlaced": {
      "on": "orders.OrderPlaced",
      "run": "StockReservation.create",
      "with": {
        "id": "concat('res-', event.data.orderId)",
        "orderId": "event.data.orderId",
        "status": "active",
        "reservedAt": "now()"
      }
    }
  }
}
