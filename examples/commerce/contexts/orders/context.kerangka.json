{
  "context": "orders",
  "glossary": {
    "Order": "A customer request to purchase items with delivery details",
    "Line": "An ordered item with quantity and agreed price"
  },
  "exports": {
    "events": ["OrderPlaced", "OrderCancelled"],
    "queries": ["getOrder"]
  },
  "entities": {
    "Order": {
      "fields": {
        "orderNumber": "string! unique",
        "customerId": "uuid!",
        "status": "enum(draft, placed, paid, shipped, cancelled) = draft",
        "lines": "list(OrderLine)",
        "totalAmount": { "type": "decimal(12,2)", "compute": "sum(lines, qty * price)" }
      },
      "workflow": {
        "field": "status",
        "transitions": {
          "place": {
            "from": "draft", "to": "placed",
            "when": "count(lines) > 0 && totalAmount > 0",
            "then": [
              { "emit": "OrderPlaced", "data": { "orderId": "id", "customerId": "customerId", "amount": "totalAmount" } }
            ]
          },
          "cancel": {
            "from": ["draft", "placed"], "to": "cancelled",
            "then": [
              { "emit": "OrderCancelled", "data": { "orderId": "id" } }
            ]
          }
        }
      }
    },
    "OrderLine": {
      "embedded": true,
      "fields": {
        "sku": "string!",
        "qty": "int! >= 1",
        "price": "decimal(12,2)! >= 0"
      }
    }
  },
  "events": {
    "OrderPlaced": {
      "orderId": "uuid!",
      "customerId": "uuid!",
      "amount": "decimal(12,2)!"
    },
    "OrderCancelled": {
      "orderId": "uuid!"
    }
  }
}
